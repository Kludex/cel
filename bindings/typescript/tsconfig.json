{
  "compilerOptions": {
    "declaration": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2024"],
    "verbatimModuleSyntax": true
  },
  "include": ["index.ts", "test/**/*.ts"]
}
